# Copie para /etc/marquezi/marquezi.env (permissão 600) e ajuste o domínio.
APP_ENV=production
HOST=127.0.0.1
PORT=5000
APP_ORIGIN=https://gestao.marquezi.com
TRUST_PROXY=1
TLS_MODE=off
SESSION_HOURS=8
MFA_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=conta-envio@example.com
SMTP_PASS=SUBSTITUA_POR_UMA_SENHA_DE_APP
SMTP_FROM=conta-envio@example.com
