# Copie para /etc/marquezi/marquezi.env e ajuste o domínio.
NODE_ENV=production
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=https://gestao.marquezi.com
TRUST_PROXY=1
TLS_MODE=off
SESSION_HOURS=8
ACCESS_TOKEN_MINUTES=15
MFA_MODE=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=conta-envio@example.com
SMTP_PASS=SUBSTITUA_POR_UMA_SENHA_DE_APP
SMTP_FROM=conta-envio@example.com
